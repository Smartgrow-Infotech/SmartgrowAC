# ── Lead delivery (Resend) ────────────────────────────────────────────
# Both are required for the contact and national-accounts forms to send.
# Without them the form deliberately FAILS and tells the customer to call,
# rather than thanking them and silently dropping the lead.
#
# 1. Create an API key:      https://resend.com/api-keys
# 2. Verify a sending domain: https://resend.com/domains
#    LEAD_FROM_EMAIL must be on that verified domain, or Resend rejects it.
RESEND_API_KEY=
LEAD_FROM_EMAIL="VGB Technologies <no-reply@example.com>"

# ── Analytics ─────────────────────────────────────────────────────────
# GA4 measurement ID. Leave blank to disable analytics entirely.
NEXT_PUBLIC_GA_ID=
